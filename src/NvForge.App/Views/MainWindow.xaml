<Window x:Class="NvForge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="760" Width="1000" MinHeight="560" MinWidth="820"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource FgBrush}"
        TextElement.FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="20,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AccentBrush}" Width="6" Height="34" CornerRadius="3" Margin="0,0,12,0" />
                <StackPanel>
                    <TextBlock Text="NvForge" Style="{StaticResource H1}" />
                    <TextBlock Text="All-in-one NVIDIA GPU manager" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Warning banner -->
        <Border Grid.Row="1" Background="#3A2E00" Padding="16,10"
                BorderBrush="{StaticResource WarnBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BannerText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Background="{StaticResource BgBrush}" BorderThickness="0" Padding="20,16">

            <!-- ===== Dashboard ===== -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Detected GPUs" Style="{StaticResource H1}" Margin="0,0,0,12" />

                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                   Text="No NVIDIA GPU detected on this system."
                                   Visibility="{Binding NoGpus, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding Gpus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                            <UniformGrid Columns="3" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="Form factor" Style="{StaticResource Muted}" FontSize="11" />
                                                    <TextBlock Text="{Binding FormFactorText}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Video memory" Style="{StaticResource Muted}" FontSize="11" />
                                                    <TextBlock Text="{Binding VramText}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Driver" Style="{StaticResource Muted}" FontSize="11" />
                                                    <TextBlock Text="{Binding DriverVersionText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Tuning capabilities" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding CapabilitiesText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LockNote}" Foreground="{StaticResource WarnBrush}"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Visibility="{Binding IsVendorLocked, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Open the Monitoring tab for live clocks, temps, fans, power and utilization." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Monitoring ===== -->
            <TabItem Header="Monitoring" DataContext="{Binding Monitoring}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Live Monitoring" Style="{StaticResource H1}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

                        <ComboBox ItemsSource="{Binding Devices}" SelectedIndex="{Binding SelectedDeviceIndex}"
                                  Background="{StaticResource PanelAltBrush}" Foreground="#10130A"
                                  Margin="0,0,0,12" Width="360" HorizontalAlignment="Left"
                                  Visibility="{Binding Available, Converter={StaticResource BoolToVis}}" />

                        <!-- Sensor tiles -->
                        <UniformGrid Columns="3"
                                     Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Temperature" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding TempText}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="GPU usage" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding UtilPercent, StringFormat={}{0:0}%}" FontSize="24" FontWeight="SemiBold" />
                                    <ProgressBar Value="{Binding UtilPercent}" Maximum="100" Height="6" Margin="0,6,0,0"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelAltBrush}" BorderThickness="0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Power" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding PowerText}" FontSize="20" FontWeight="SemiBold" />
                                    <ProgressBar Value="{Binding PowerPercent}" Maximum="100" Height="6" Margin="0,6,0,0"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelAltBrush}" BorderThickness="0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Core clock" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding CoreClockText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,12">
                                <StackPanel>
                                    <TextBlock Text="Memory clock" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding MemClockText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Fan" Style="{StaticResource Muted}" FontSize="11" />
                                    <TextBlock Text="{Binding FanText}" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- VRAM -->
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Video memory" Style="{StaticResource Muted}" FontSize="11" />
                                <TextBlock Text="{Binding VramText}" FontSize="18" FontWeight="SemiBold" />
                                <ProgressBar Value="{Binding MemUtilPercent}" Maximum="100" Height="6" Margin="0,6,0,0"
                                             Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelAltBrush}" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <!-- Utilization history sparkline -->
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="GPU usage history" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <Border Height="90" Background="{StaticResource PanelAltBrush}" CornerRadius="4" Padding="4" ClipToBounds="True">
                                    <Polyline Points="{Binding UtilizationPoints}" Stretch="Fill"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
                                </Border>
                                <TextBlock Text="{Binding UtilStatsText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding TempStatsText}" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{Binding PowerStatsText}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </Border>

                        <!-- Controls -->
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="Start / stop CSV log" Command="{Binding ToggleLoggingCommand}" />
                                    <Button Content="Reset min/avg/max" Style="{StaticResource SecondaryButton}" Command="{Binding ResetStatsCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding LoggingStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Tuning ===== -->
            <TabItem Header="Tuning" DataContext="{Binding Tuning}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Overclocking &amp; Tuning" Style="{StaticResource H1}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

                        <Border Background="#3A2E00" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                       Text="Overclocking is EXPERIMENTAL and at your own risk. Apply runs a 15-second test — click Keep to confirm, otherwise it auto-reverts. Laptop GPUs are usually locked by the vendor." />
                        </Border>

                        <ComboBox ItemsSource="{Binding Devices}" SelectedIndex="{Binding SelectedDeviceIndex}"
                                  Background="{StaticResource PanelAltBrush}" Foreground="#10130A"
                                  Margin="0,0,0,12" Width="360" HorizontalAlignment="Left"
                                  Visibility="{Binding Available, Converter={StaticResource BoolToVis}}" />

                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding LockNote}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Core clock offset" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="{Binding CoreMin}" Maximum="{Binding CoreMax}"
                                            Value="{Binding CoreOffset}" IsEnabled="{Binding CoreEditable}"
                                            VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding CoreOffset, StringFormat={}{0:+#;-#;0} MHz}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Memory clock offset" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="{Binding MemoryMin}" Maximum="{Binding MemoryMax}"
                                            Value="{Binding MemoryOffset}" IsEnabled="{Binding MemoryEditable}"
                                            VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryOffset, StringFormat={}{0:+#;-#;0} MHz}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <WrapPanel>
                                    <Button Content="Apply" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" />
                                    <Button Content="Reset to stock" Style="{StaticResource SecondaryButton}" Command="{Binding ResetCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ApplyStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Test-then-revert countdown -->
                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding RevertPending, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding RevertSecondsLeft, StringFormat=Testing — auto-revert in {0}s unless you keep it.}" />
                                <Button Content="Keep" Command="{Binding KeepCommand}" Margin="14,0,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Profiles -->
                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Profiles" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                             Background="{StaticResource PanelAltBrush}" Foreground="{StaticResource FgBrush}"
                                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,8,0" />
                                    <Button Content="Save current" Command="{Binding SaveProfileCommand}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}"
                                              Width="200" Margin="0,0,8,0"
                                              Background="{StaticResource PanelAltBrush}" Foreground="#10130A" />
                                    <Button Content="Load" Style="{StaticResource SecondaryButton}" Command="{Binding LoadProfileCommand}" />
                                    <Button Content="Delete" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteProfileCommand}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Driver Customization ===== -->
            <TabItem Header="Driver Customization" DataContext="{Binding Driver}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Driver Customization" Style="{StaticResource H1}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding TargetGpuText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />

                        <!-- Step 1: NVCleanstall -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Step 1 — Customize &amp; install the driver with NVCleanstall" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding NvCleanstallStatus}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Content="Launch NVCleanstall" Command="{Binding LaunchNvCleanstallCommand}"
                                            IsEnabled="{Binding NvCleanstallFound}" />
                                    <Button Content="Get NVCleanstall" Style="{StaticResource SecondaryButton}" Command="{Binding GetNvCleanstallCommand}" />
                                    <Button Content="Re-check" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshNvCleanstallCommand}" />
                                    <Button Content="Open NVIDIA driver page" Style="{StaticResource SecondaryButton}" Command="{Binding OpenDriversPageCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Recommendations -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Recommended components" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Use this as a guide for the component screen inside NVCleanstall." />
                                <ItemsControl ItemsSource="{Binding Recommendations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="4" Padding="6,2" Margin="0,2,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStrip}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource StripBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Action}" Foreground="#10130A" FontWeight="SemiBold"
                                                               FontSize="11" HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <Run Text="  ·  " Foreground="{StaticResource MutedBrush}" />
                                                        <Run Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: Tweaks -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Step 2 — Post-install tweaks (reversible)" Style="{StaticResource H2}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Each tweak backs up the original state first. Use Restore to undo any change exactly." />
                                <ItemsControl ItemsSource="{Binding Tweaks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" />
                                                    <WrapPanel>
                                                        <Button Content="Apply" Command="{Binding ApplyCommand}" />
                                                        <Button Content="Restore" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Windows Tweaks ===== -->
            <TabItem Header="Windows Tweaks" DataContext="{Binding WindowsTweaks}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Windows Performance Tweaks" Style="{StaticResource H1}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                                   Text="Each tweak is backed up before applying and can be reverted with Restore. Some require a reboot to take effect." />
                        <ItemsControl ItemsSource="{Binding Tweaks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" />
                                            <WrapPanel>
                                                <Button Content="Apply" Command="{Binding ApplyCommand}" />
                                                <Button Content="Restore" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Diagnostics ===== -->
            <TabItem Header="Diagnostics" DataContext="{Binding Diagnostics}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        <Button Content="Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopyCommand}" />
                        <Button Content="Save…" Style="{StaticResource SecondaryButton}" Command="{Binding SaveCommand}" />
                    </WrapPanel>
                    <TextBox Grid.Row="1" Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             Background="{StaticResource PanelBrush}" Foreground="{StaticResource FgBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Padding="10" />
                </Grid>
            </TabItem>

            <!-- ===== About ===== -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="About NvForge" Style="{StaticResource H1}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6">
                            <Run Text="Version" /><Run Text=" " /><Run Text="{Binding AppVersion}" />
                        </TextBlock>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="What this is" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="NvForge is an all-in-one NVIDIA GPU manager. It detects your GPU(s), customizes drivers (NVCleanstall + reversible privacy/update tweaks), monitors live sensors, applies experimental overclock offsets, and toggles reversible Windows performance tweaks — across both desktop and laptop GPUs." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Possible follow-ups" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="• NVIDIA Control Panel settings (low-latency / power mode) via NVAPI&#x0a;• Fan-curve editor and power-limit control&#x0a;• On-hardware validation of the overclocking write path" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Honest notes" Style="{StaticResource H2}" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="• Laptop GPUs (like the RTX 5070 Ti mobile) usually have power/voltage locked by the vendor — those controls will be limited.&#x0a;• NVCleanstall is third-party freeware; NvForge detects and launches your own copy, it does not bundle or modify it.&#x0a;• Driver tweaks require Administrator and edit the registry / services / scheduled tasks — always reversible via Restore." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
