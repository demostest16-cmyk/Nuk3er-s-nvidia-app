<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>NvForge.App</RootNamespace>
    <AssemblyName>NvForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publishing (single-file, self-contained, untrimmed) is done by CI via
         the `dotnet publish` command line so plain dev builds stay lightweight.
         Trimming is intentionally never enabled: it breaks WPF. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NvForge.Core\NvForge.Core.csproj" />
    <ProjectReference Include="..\NvForge.Hardware\NvForge.Hardware.csproj" />
    <ProjectReference Include="..\NvForge.Nvml\NvForge.Nvml.csproj" />
    <ProjectReference Include="..\NvForge.DriverCustomizer\NvForge.DriverCustomizer.csproj" />
  </ItemGroup>

</Project>
